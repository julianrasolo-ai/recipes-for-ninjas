   "id": "w01",
   "cat": "grill",
   "title": "Smoky garlic butter steak",
   "emoji": "🥩",
   "blurb": "Charred outside, juicy inside, with a whisper of hardwood smoke.",
   "ing": [
    "2 ribeye or strip steaks, 1 inch thick",
    "1 tbsp oil",
    "Salt and pepper",
    "2 tbsp butter mixed with 1 grated garlic clove and parsley"
   ],
   "steps": [
    "Take steaks out 30 minutes early. Oil and season well.",
    "Fill the smoke box with pellets and press Woodfire Flavor. Select Grill, HI, and preheat.",
    "Grill 4–5 minutes per side for medium-rare (130°F on a thermometer).",
    "Rest 5 minutes topped with the garlic butter."
   ],
   "tags": [
    "beef",
    "oil",
    "butter",
    "garlic"
