// Cloudflare Workers deploy config (used by Workers Builds: build `npm run build`, deploy `npx wrangler deploy`).
{
  "name": "recipes-for-ninjas",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  // Custom domain (zone on this Cloudflare account): deploy creates the DNS records and certificate.
  "routes": [
    { "pattern": "recipesbyninjas.com", "custom_domain": true },
    { "pattern": "www.recipesbyninjas.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Shared storage: family favorites, AI usage counters, newsletter and contact form entries.
  "kv_namespaces": [{ "binding": "RFN_KV", "id": "13455c02f3224ba08f30b918c5caf7f3" }],
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true }
}
